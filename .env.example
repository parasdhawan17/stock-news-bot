# Copy to .env for local testing (never commit .env)
FINNHUB_API_KEY=your-finnhub-key

# WhatsApp via CallMeBot (optional — only needed with --whatsapp)
WHATSAPP_PHONE=+91xxxxxxxxxx
CALLMEBOT_API_KEY=your-callmebot-key

# Email via Brevo (optional — only needed with --email)
BREVO_API_KEY=your-brevo-api-key
EMAIL_TO=you@example.com
EMAIL_FROM=digest@yourdomain.com
EMAIL_FROM_NAME="Stock News Bot"

# Web digest footer link (optional — used in WhatsApp/email footers)
SITE_URL=https://your-username.github.io/stock-news-bot
